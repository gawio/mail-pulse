# OAuth client ID loại "Web application" (Google Cloud Console)
VITE_GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com
# Client secret của cùng OAuth client (Google bắt buộc khi đổi code / làm mới token). Sẽ nằm trong bản build extension.
VITE_GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Public key (base64, DER/SPKI) — tạo bằng `npm run gen-key`, giữ extension ID cố định
EXTENSION_KEY=
# Firefox: add-on ID cố định (định dạng email, nên đặt riêng cho bạn). Redirect URI Firefox phụ thuộc ID này.
FIREFOX_ADDON_ID=mail-pulse@personal.local
